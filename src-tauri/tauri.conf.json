{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "晴笺",
  "version": "0.3.0",
  "identifier": "com.zxl.qingjian",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "晴笺", "width": 1200, "height": 780, "minWidth": 780, "minHeight": 600 }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": ["msi", "nsis"], "icon": ["icons/icon.ico"], "windows": { "wix": { "language": "zh-CN" }, "nsis": { "languages": ["SimpChinese"] } } }
}
